# /etc/systemd/system/ledger-backup.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now ledger-backup.timer
# 서버가 그 시각에 꺼져 있었으면 켜진 뒤 한 번 따라잡는다(Persistent)
[Unit]
Description=Daily ledger backup at 04:10 KST

[Timer]
OnCalendar=*-*-* 04:10:00 Asia/Seoul
Persistent=true

[Install]
WantedBy=timers.target
