<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ledger.auth.dao.AuthDAO">

    <select id="selectUserByUsername" parameterType="string" resultType="java.util.HashMap">
        SELECT id, username, password_hash, pay_day, pay_day_adjust
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="selectPasswordHash" parameterType="long" resultType="string">
        SELECT password_hash FROM app_user WHERE id = #{userId}
    </select>

    <update id="updatePassword" parameterType="map">
        UPDATE app_user SET password_hash = #{passwordHash} WHERE id = #{userId}
    </update>

    <!-- 기록 초기화·탈퇴: AuthServiceImpl 이 이 순서대로 한 트랜잭션에서 실행한다(자식 → 부모. 외래 키가 NO ACTION 이라 순서가 바뀌면 실패하고 전부 되돌려진다).
         정기 이체 처리 기록·고정 항목 처리 기록은 ON DELETE CASCADE 로 함께 지워진다 -->
    <delete id="deleteRecurringTransfers" parameterType="long">DELETE FROM recurring_transfer WHERE user_id = #{userId}</delete>
    <delete id="deleteTransfers" parameterType="long">DELETE FROM account_transfer WHERE user_id = #{userId}</delete>
    <delete id="deleteRecurringItems" parameterType="long">DELETE FROM recurring_item WHERE user_id = #{userId}</delete>
    <delete id="deleteEntries" parameterType="long">DELETE FROM ledger_entry WHERE user_id = #{userId}</delete>
    <delete id="deleteBankAccounts" parameterType="long">DELETE FROM bank_account WHERE user_id = #{userId}</delete>
    <delete id="deleteAssets" parameterType="long">DELETE FROM asset WHERE user_id = #{userId}</delete>
    <update id="resetOpeningBalance" parameterType="long">UPDATE app_user SET opening_balance = 0, opening_date = NULL WHERE id = #{userId}</update>
    <!-- 탈퇴만: 위의 기록을 지운 뒤 -->
    <delete id="deleteCategories" parameterType="long">DELETE FROM category WHERE user_id = #{userId}</delete>
    <delete id="deletePaymentMethods" parameterType="long">DELETE FROM payment_method WHERE user_id = #{userId}</delete>
    <delete id="deleteUser" parameterType="long">DELETE FROM app_user WHERE id = #{userId}</delete>

    <insert id="insertUser" parameterType="map" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO app_user (username, password_hash)
        VALUES (#{username}, #{passwordHash})
    </insert>

    <!-- 가입 시 기본 카테고리. group_name 은 "총 식비" 같은 묶음 집계용 -->
    <insert id="insertDefaultCategories" parameterType="map">
        INSERT INTO category (user_id, name, type, group_name, sort_order) VALUES
        (#{id}, '식비',      'EXPENSE', '식비', 1),
        (#{id}, '배달',      'EXPENSE', '식비', 2),
        (#{id}, '카페/간식', 'EXPENSE', '식비', 3),
        (#{id}, '장보기',    'EXPENSE', '식비', 4),
        (#{id}, '교통',      'EXPENSE', NULL,   5),
        (#{id}, '고정지출',  'EXPENSE', NULL,   6),
        (#{id}, '저축',      'EXPENSE', NULL,   7),
        (#{id}, '기타',      'EXPENSE', NULL,   8),
        (#{id}, '급여',      'INCOME',  NULL,   1),
        (#{id}, '기타',      'INCOME',  NULL,   2)
    </insert>

    <insert id="insertDefaultPaymentMethods" parameterType="map">
        INSERT INTO payment_method (user_id, name, sort_order) VALUES
        (#{id}, '신용카드', 1),
        (#{id}, '체크카드', 2),
        (#{id}, '계좌이체', 3),
        (#{id}, '현금',     4)
    </insert>
</mapper>
